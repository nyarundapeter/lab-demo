# Base URL of the DWS.07 backend this app proxies into.
BIOTEST_BASE_URL=http://localhost:3000

# Must match the tenant DWS.07's fixtures seed under (see
# Biotest/apps/dws-07/solution/fixtures/seed.ts) — tenant-alpha.
BIOTEST_TENANT_ID=tenant-alpha

# Only meaningful once DWS.07 adds a trusted-caller guard on its PS.DATA route
# (not present as of this app's creation — confirmed by reading
# Biotest/apps/dws-07/app/api/platform/data/[[...path]]/route.ts directly).
# Safe to leave unset until that guard exists.
BIOTEST_INTERNAL_SHARED_SECRET=
